# Must be the same Redis the notification-service worker reads from
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=
REDIS_TLS=
# Must match the notification-service constants
LEAD_NURTURE_QUEUE_NAME=
LEAD_NURTURE_JOB_NAME=
READINESS_LINK_BASE_URL=
ENQUEUE_TIMEOUT_MS=

LEAD_NURTURE_SCHEDULER_ENABLED=
LEAD_NURTURE_DRY_RUN=
VSL_API_BASE_URL=
VSL_WORKR_API_KEY=

# only to avoid waiting for a quarter-hour tick or the 10:00–19:00 window while testing:
LEAD_NURTURE_TICK_MINUTES=
LEAD_NURTURE_WINDOW_START_HOUR_IST=
LEAD_NURTURE_WINDOW_END_HOUR_IST=


# sequelize-cli (npm run migrate) reads these in development: keep identical to the local DB_* above
DEV_DB_HOST=
DEV_DB_USER=
DEV_DB_PASSWORD=
DEV_DB_NAME=
